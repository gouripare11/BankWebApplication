<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>BankController</servlet-name>
        <servlet-class>com.gouri.controller.BankController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RController</servlet-name>
        <servlet-class>com.gouri.controller.RController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Lcontroller</servlet-name>
        <servlet-class>com.gouri.controller.Lcontroller</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CreateAccController</servlet-name>
        <servlet-class>com.gouri.controller.CreateAccController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CheckBalance</servlet-name>
        <servlet-class>com.gouri.controller.CheckBalance</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TransferController</servlet-name>
        <servlet-class>com.gouri.controller.TransferController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>History</servlet-name>
        <servlet-class>com.gouri.controller.History</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BController</servlet-name>
        <servlet-class>com.gouri.controller.BController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BankController</servlet-name>
        <url-pattern>/BankController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RController</servlet-name>
        <url-pattern>/RController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Lcontroller</servlet-name>
        <url-pattern>/Lcontroller</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CreateAccController</servlet-name>
        <url-pattern>/CreateAccController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CheckBalance</servlet-name>
        <url-pattern>/CheckBalance</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TransferController</servlet-name>
        <url-pattern>/TransferController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>History</servlet-name>
        <url-pattern>/History</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BController</servlet-name>
        <url-pattern>/BController</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
